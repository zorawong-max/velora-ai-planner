# AI provider — selects the backend implementation in src/lib/ai/index.ts.
# Currently supported: "openai". Add new providers under
# src/lib/ai/providers/ and extend the factory to support more.
AI_PROVIDER=openai

# OpenAI (required while AI_PROVIDER=openai)
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini if unset.
OPENAI_MODEL=

# Supabase — public anon client (safe to expose to the browser). This is a
# separate Supabase project from the VELORA corporate site; RFQ submissions
# for the AI Planner live in their own database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
